{
  "name": "next-ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fix-line-endings": "find . \\( -path \"./node_modules\" -o -path \"./.next\" \\) -prune -o -type f -exec unix2dos {} +",
    "format": "npx prettier . --write && npm run fix-line-endings"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "iconoir-react": "^7.11.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
